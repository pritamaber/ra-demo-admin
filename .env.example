# Copy this file to .env and fill in your Supabase project's values.
# Get these from the Supabase dashboard: Project Settings -> API.
# SUPABASE_SERVICE_KEY is the "service_role" secret key -- never the anon/publishable one,
# and never prefix it with NEXT_PUBLIC_ (that would ship it to browsers). Server-side only.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_IMAGE_BUCKET=product-images
